<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:animateLayoutChanges="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
         android:paddingTop="20dp"
         android:paddingBottom="16dp"
         android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                 android:text="GENERATOR"
                android:textColor="@color/foreground"
                android:textSize="18sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot_bg"
                    android:backgroundTint="@color/muted_foreground" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDLE"
                    android:textColor="@color/muted_foreground"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Discord account generator &amp; console"
            android:textColor="@color/muted_foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- WebView container — keeps WebView alive across tab switches.
         The overlay (web_view_overlay) is shown on top when "Show WebView" is OFF
         and no captcha/stuck state requires user interaction. -->
    <FrameLayout
        android:id="@+id/web_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Black overlay — shown when generator is idle or running in background.
             Auto-hides when captcha or stuck state needs user action. -->
        <LinearLayout
            android:id="@+id/web_view_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
             android:background="@drawable/overlay_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:id="@+id/overlay_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Start Generation first"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Press START to begin generating accounts"
                android:textColor="#888888"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Console divider + header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_alt"
         android:elevation="1dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONSOLE"
            android:textColor="@color/muted_foreground"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/counter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Generated: 0"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- CONTINUE button — shown when automation is stuck -->
        <TextView
            android:id="@+id/continue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ CONTINUE"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="#57f287"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clear_console_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLEAR"
            android:textColor="@color/muted_foreground"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    
    <HorizontalScrollView
        android:id="@+id/session_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:id="@+id/session_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Console log 30% -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/log_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/background"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- Bottom bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
         android:elevation="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/webview_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REGISTER"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="44dp"
            android:padding="0dp"
             app:backgroundTint="@color/primary"
             app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause_button"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="PAUSE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            android:visibility="gone"
             app:backgroundTint="#E67E22"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_stop_button"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
             app:backgroundTint="@color/primary"
             app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
