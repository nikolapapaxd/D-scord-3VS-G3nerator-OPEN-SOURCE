<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="2dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <!-- Row 1: status dot + email + badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/select_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:buttonTint="@color/primary" />

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_bg"
            android:backgroundTint="@color/muted_foreground" />

        <TextView
            android:id="@+id/email_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/foreground"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/verified_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="✓"
            android:textColor="#57f287"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- Row 2: token preview -->
    <TextView
        android:id="@+id/token_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        android:ellipsize="end"
        android:singleLine="true" />

    <!-- Row 3: date + score + phone + actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/phone_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/copy_combo_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMBO"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/copy_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOKEN"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:paddingStart="4dp"
            android:paddingEnd="0dp" />
    </LinearLayout>

    <!-- Row 4: notes (shown when non-empty) -->
    <TextView
        android:id="@+id/notes_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        android:ellipsize="end"
        android:singleLine="true" />

</LinearLayout>
