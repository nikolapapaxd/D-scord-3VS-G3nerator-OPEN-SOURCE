<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
         android:paddingTop="20dp"
         android:paddingBottom="14dp"
         android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SERVER JOINER"
                android:textColor="@color/foreground"
                android:textSize="17sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <!-- Stats row -->
            <TextView
                android:id="@+id/join_stat_joined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓0"
                android:textColor="#57f287"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/join_stat_failed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕0"
                android:textColor="#ed4245"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/join_stat_captcha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠0"
                android:textColor="#fee75c"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Join Discord servers with generated or custom accounts"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

    <!-- ── WebView panel (hidden until joining starts) ──────────────────────── -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Divider between WebView and controls (shown together with WebView) -->
    <View
        android:id="@+id/webview_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:visibility="gone" />

    <!-- Captcha banner (shown when captcha is detected) -->
    <LinearLayout
        android:id="@+id/captcha_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1a1b1e"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠  Captcha detected — solve it in the panel above, then tap:"
            android:textColor="#fee75c"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_captcha_solved"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="CAPTCHA SOLVED"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@color/primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ── Controls scroll area ─────────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/scroll_controls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ── INVITE LINKS ───────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="INVITE LINKS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <!-- Add link input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <EditText
                        android:id="@+id/edit_invite_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:hint="discord.gg/code or discord.com/invite/code"
                        app:hintTextColor="@color/muted_foreground"
                        android:textColor="@color/foreground"
                        android:textSize="12sp"
                         android:background="@drawable/input_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/btn_add_link"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="ADD"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@color/primary"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>

                <!-- Action buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/btn_import_links"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMPORT CLIPBOARD"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btn_clear_links"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR ALL"
                        android:textColor="@color/destructive"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Links list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/links_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty hint -->
                <TextView
                    android:id="@+id/links_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="No invite links added yet"
                    android:textColor="@color/muted_foreground"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- ── ACCOUNTS ───────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="ACCOUNT SOURCE"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Radio group: Generated / Manual -->
                <RadioGroup
                    android:id="@+id/rg_account_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_source_generated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Generated Accounts"
                        android:textColor="@color/foreground"
                        android:textSize="13sp"
                        android:checked="true"
                        android:buttonTint="@color/primary" />

                    <RadioButton
                        android:id="@+id/rb_source_manual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Manual Combos"
                        android:textColor="@color/foreground"
                        android:textSize="13sp"
                        android:buttonTint="@color/primary" />
                </RadioGroup>

                <!-- Generated accounts info -->
                <LinearLayout
                    android:id="@+id/panel_generated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/gen_account_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0 accounts in database"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp" />

                        <RadioGroup
                            android:id="@+id/rg_gen_filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_gen_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All"
                                android:textColor="@color/foreground"
                                android:textSize="11sp"
                                android:checked="true"
                                android:buttonTint="@color/primary" />

                            <RadioButton
                                android:id="@+id/rb_gen_valid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Valid only"
                                android:textColor="@color/foreground"
                                android:textSize="11sp"
                                android:buttonTint="@color/primary" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>

                <!-- Manual combos input -->
                <LinearLayout
                    android:id="@+id/panel_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="One per line — token only, or email:pass:token"
                        android:textColor="@color/muted_foreground"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/edit_manual_combos"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:hint="MTk5NjE2MjQ4Mzk2MDk2OTY0.abcd.xyz&#10;email@x.com:password:TOKEN&#10;…"
                        app:hintTextColor="@color/muted_foreground"
                        android:textColor="@color/foreground"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:background="@color/surface"
                        android:padding="10dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/manual_combo_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 tokens parsed"
                        android:textColor="@color/muted_foreground"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── SETTINGS ───────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="JOIN SETTINGS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <!-- Delay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delay Between Joins"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/delay_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 seconds"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/delay_seekbar"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:max="30"
                        android:progress="3"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                <!-- Auto-solve captcha toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-Solve Captcha"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use NopeCHA to auto-solve join captchas"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_joiner_captcha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                <!-- Use proxy toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Route Through Proxy"
                            android:textColor="@color/foreground"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use proxy from Settings for join requests"
                            android:textColor="@color/muted_foreground"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_joiner_proxy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Joiner mode -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:text="Join method"
                android:textColor="@color/muted_foreground"
                android:textSize="12sp" />
            <RadioGroup
                android:id="@+id/rg_joiner_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rb_joiner_hybrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hybrid (API first, WebView fallback) — fastest"
                    android:textColor="@color/foreground"
                    android:textSize="13sp"
                    android:checked="true"
                    android:buttonTint="@color/primary" />
                <RadioButton
                    android:id="@+id/rb_joiner_webview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WebView Joiner only"
                    android:textColor="@color/foreground"
                    android:textSize="13sp"
                    android:buttonTint="@color/primary" />
                <RadioButton
                    android:id="@+id/rb_joiner_api"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="API Joiner only (fast, more captchas)"
                    android:textColor="@color/foreground"
                    android:textSize="13sp"
                    android:buttonTint="@color/primary" />
            </RadioGroup>

            <!-- ── START / STOP BUTTONS ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_start_join"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▶  START JOINING"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_stop_join"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="■  STOP"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@color/destructive"
                    android:layout_marginStart="6dp"
                    android:enabled="false"
                    android:alpha="0.4" />
            </LinearLayout>

            <!-- ── LOGS ───────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="LOGS"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:minHeight="100dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/join_log_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/join_log_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:text="No join attempts yet"
                    android:textColor="@color/muted_foreground"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
